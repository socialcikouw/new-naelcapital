+// definisi ulang properti non-configurable melempar "property is not
+// writable". Sama dengan usulan react/react-native#56316.
+if (!Object.prototype.hasOwnProperty.call(global, '__FUSEBOX_REACT_DEVTOOLS_DISPATCHER__')) {
+  Object.defineProperty(global, '__FUSEBOX_REACT_DEVTOOLS_DISPATCHER__', {
+    value: FuseboxReactDevToolsDispatcher,
+    configurable: false,
+    enumerable: false,
+    writable: false,
+  });
